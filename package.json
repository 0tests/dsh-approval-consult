{
  "name": "dsh-approval-consult",
  "version": "1.3.1",
  "license": "MIT",
  "type": "module",
  "description": "Approval consultation panel for DeepSeek Harness: while a tool call waits for approval, ask the executor AI and the auto-review AI independently, in two isolated channels with prompt-cache reuse.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0tests/dsh-approval-consult.git"
  },
  "homepage": "https://github.com/0tests/dsh-approval-consult#readme",
  "bugs": {
    "url": "https://github.com/0tests/dsh-approval-consult/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/impl.js",
    "lib/dsh-go.js",
    "lib/client.js",
    "lib/review-policy.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "docs/DSH-GO.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node tests/unit.mjs && node tests/locale-parity.mjs && node tests/css-classes.mjs && node tests/security.mjs && node tests/security-lifecycle.mjs && node tests/backend-budget-lifecycle.mjs && node tests/compatibility.mjs && node tests/client-lifecycle.mjs && node tests/web-approval-lifecycle.mjs && node tests/dsh-go.mjs && node tests/mobile.mjs",
    "test:upstream": "node tests/upstream-contract.mjs",
    "test:go": "node tests/dsh-go-contract.mjs",
    "test:browser": "node tests/mobile-browser.mjs",
    "check": "node --check lib/impl.js && node --check lib/client.js && node --check lib/index.js && node --check lib/dsh-go.js"
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0",
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.2-rc.1": "compatible",
        "0.2.2-rc.2": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-approval"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "minApp": "1.0.15",
    "title": { "zh": "审批咨询", "en": "Approval consult" },
    "icon": "chat",
    "contributes": {
      "composer.tools": [
        { "id": "consult-tool", "label": { "zh": "审批咨询", "en": "Consult" }, "icon": "chat", "panel": "consult" }
      ],
      "session.actions": [
        { "id": "open-consult", "label": { "zh": "审批咨询", "en": "Consult" }, "icon": "chat", "effect": { "type": "open", "page": "panel:consult" } }
      ],
      "panels": [
        { "id": "consult", "title": { "zh": "审批咨询", "en": "Consult" }, "icon": "chat", "placement": ["session.tab", "chat.panel"], "presentation": "sheet" },
        { "id": "consult-live", "title": { "zh": "实时回答", "en": "Live answers" }, "icon": "chat", "placement": ["chat.panel"], "presentation": "sheet" }
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "approval",
    "approval-workflow",
    "auto-review",
    "ai-safety",
    "human-in-the-loop"
  ]
}
