{
  "name": "dsh-approval-consult",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Approval consultation panel for DeepSeek Harness: while a tool call waits for approval, ask the executor AI and the auto-review AI independently, in two isolated channels with prompt-cache reuse.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0tests/dsh-approval-consult.git"
  },
  "homepage": "https://github.com/0tests/dsh-approval-consult#readme",
  "bugs": {
    "url": "https://github.com/0tests/dsh-approval-consult/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/impl.js",
    "lib/client.js",
    "lib/review-policy.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node tests/unit.mjs && node tests/locale-parity.mjs && node tests/css-classes.mjs",
    "check": "node --check lib/impl.js && node --check lib/client.js && node --check lib/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-approval"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "approval",
    "approval-workflow",
    "auto-review",
    "ai-safety",
    "human-in-the-loop"
  ]
}
